# Names only / non-secret samples. Copy to .env and fill in real values.
# PostgreSQL is installed directly on the OS (no Docker). Create the role/database as described in README.
DATABASE_URL=postgresql://news:CHANGE_ME@localhost:5432/news
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=پلتفرم خبری
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_API_TOKEN=            # long random string (>= 24 chars); admin endpoints are denied when empty
USER_AGENT=NewsPlatformBot/0.1 (+contact: set-your-contact-url)
# AI provider (not wired yet, see README)
AI_PROVIDER=none
AI_API_KEY=
